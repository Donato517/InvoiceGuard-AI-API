# =============================================================
# InvoiceGuard-AI-API 環境變數範本
# - 僅列設定名稱與安全預設；公司密鑰不得交付一般開發者
# - 預設不讀 .env；本機只使用公開程序設定，雲端由平台注入機密
# - Vercel：於 Project Settings → Environment Variables 設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production
APP_ENV=local
# true 時開放 /docs API 文件（正式環境必須為 false）
DEBUG=false
MODULE_BACKEND=auto
REMOTE_API_BASE_URL=

# ---- 雲端資料庫（供應商與連線模式需由管理者確認）----
# 應用程式使用 pooled 連線字串
DATABASE_URL=
# Alembic migration 使用直連（unpooled）字串；未填時沿用 DATABASE_URL
DATABASE_URL_UNPOOLED=
DB_POOL_MODE=transaction
DB_SSL_MODE=require
DB_CONNECT_TIMEOUT_SECONDS=5

# ---- 安全 ----
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Vercel Cron 驗證用，至少 16 字元的隨機字串
CRON_SECRET=

# ---- 外部服務 ----
# AI 模型服務金鑰
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# 財政部電子發票整合服務平台
EINVOICE_APP_ID=
EINVOICE_API_KEY=
# 檔案儲存（Vercel Blob）
BLOB_READ_WRITE_TOKEN=

# Supabase Storage：目前僅驗證設定與契約，尚未接線
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
