# =============================================================
# InvoiceGuard-AI-API 環境變數範本
# - 本機：複製為 .env 後填值（.env 不得提交版控）
# - Vercel：於 Project Settings → Environment Variables 設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production
APP_ENV=local
# true 時開放 /docs API 文件（正式環境必須為 false）
DEBUG=true

# ---- 資料庫（PostgreSQL，Vercel Marketplace 建議使用 Neon）----
# 應用程式使用 pooled 連線字串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoiceguard
# Alembic migration 使用直連（unpooled）字串；未填時沿用 DATABASE_URL
DATABASE_URL_UNPOOLED=

# ---- 安全 ----
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60
# Vercel Cron 驗證用，至少 16 字元的隨機字串
CRON_SECRET=change-me-to-a-random-string

# ---- 外部服務 ----
# AI 模型服務金鑰
AI_API_KEY=
# 財政部電子發票整合服務平台
EINVOICE_APP_ID=
EINVOICE_API_KEY=
# 檔案儲存（Vercel Blob）
BLOB_READ_WRITE_TOKEN=
