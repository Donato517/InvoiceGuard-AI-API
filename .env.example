# =============================================================
# InvoiceGuard-AI-API 環境變數範本
# - 僅列設定名稱與安全預設；公司密鑰不得交付一般開發者
# - 不讀 dotenv；本機公開 URL 使用 STARTUP/dev-urls.local.json，機密僅由雲端注入
# - Vercel：於 Project Settings → Environment Variables 分 Preview／Production 設定
# - VERCEL／VERCEL_ENV 由平台注入；APP_ENV 必須對應 preview／production
# - 詳見 docs/ENVIRONMENT_ISOLATION.md；此檔不是可直接套用的雲端設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production
APP_ENV=local
# true 時開放 /docs API 文件（正式環境必須為 false）
DEBUG=false
MODULE_BACKEND=auto
REMOTE_API_BASE_URL=

# ---- 雲端資料庫（供應商與連線模式需由管理者確認）----
# 應用程式使用 pooled 連線字串
DATABASE_URL=
# Alembic migration 使用直連（unpooled）字串；未填時沿用 DATABASE_URL
DATABASE_URL_UNPOOLED=
DB_POOL_MODE=transaction
DB_SSL_MODE=require
DB_CONNECT_TIMEOUT_SECONDS=5

# ---- 安全 ----
# 舊 JWT 金鑰；登入已改用 v1.3 Session，不需設定
JWT_SECRET_KEY=
# 登入 Session 有效分鐘數（1–1440）
SESSION_EXPIRE_MINUTES=60
# Vercel Cron 驗證用，至少 16 字元的隨機字串
CRON_SECRET=

# ---- 外部服務 ----
# AI 模型服務金鑰
AI_API_KEY=
GEMINI_API_KEY=
# Gemini 對話模型（預設 gemini-3.8-flash）
GEMINI_MODEL=gemini-3.8-flash
# Groq 對話：預設／識別用 20B，RAG／討論／進階備用用 120B
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_ADVANCED_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# Google Document AI（OCR）：專案、區域（us／eu）、Processor ID、服務帳號完整 JSON
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# 財政部電子發票整合服務平台
EINVOICE_APP_ID=
EINVOICE_API_KEY=
# 舊 Vercel Blob 保留名稱：未接線、不自動選用；Storage 方向見下方 Supabase（尚未接線）
BLOB_READ_WRITE_TOKEN=

# Supabase Storage：目前僅驗證設定與契約，尚未接線
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
# Supabase Storage S3 相容端點（app/integrations/supabase_storage.py；本機由 START 經 Vercel CLI 注入）
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
